# ---- veri tabanı (zorunlu) ----
DATABASE_URL=postgresql://postgres:1@localhost:5432/finans

# ---- TEFAS fon fiyatları (opsiyonel) ----
# Boşsa fonlar elle fiyatlanır. _2: birincisi 429 alırsa otomatik devreye girer.
RAPIDAPI_KEY=
RAPIDAPI_KEY_2=

# ---- e-posta: gönderim yolu ----
# smtp (varsayılan) | gmail | resend
# Render ücretsiz web servisleri SMTP portlarını (25/465/587) ENGELLER → "connection timeout".
# Ayar hatası değildir, parola değiştirmek çözmez; gmail/resend 443 kullanır.
MAIL_PROVIDER=smtp

# YOL: gmail — Gmail API, domain gerektirmez, herkese ulaşır, yetki yalnız gönderme.
# Token üretimi: pnpm --filter @finans/server gmail-token (kurulum: scripts/gmail-token.mjs)
# OAuth ekranı "In Production" olmalı — "Testing"de token 7 günde bir ölür.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Yetkilendirilen adres; From bu olmak zorunda.
GMAIL_SENDER=

# YOL: resend — HTTP API. MAIL_FROM boşsa test göndereni kullanılır ve postalar
# YALNIZ Resend hesabının kendi adresine ulaşır (yeni kullanıcı aktive edilemez).
RESEND_API_KEY=

# YOL: smtp
#   Gmail:  smtp.gmail.com : 587 : <adres> : <uygulama parolası, normal şifre değil>
#   Resend: smtp.resend.com : 587 : resend : <API anahtarı>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gönderen (boşsa yola göre türetilir). Prod'da doğrulanmış domain'inden ver.
MAIL_FROM=

# ---- AI asistan (opsiyonel; boşsa sekme kapalı) ----
# gemini | openai (openai = /chat/completions uyumlu her servis: Groq, OpenRouter, Ollama…)
# Seçilen model FUNCTION CALLING desteklemeli, yoksa hiçbir kayıt oluşturamaz.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Yedekler: kota (429) veya geçersiz anahtarda sıraya geçilir. Virgülle de verilebilir.
AI_API_KEY_2=
AI_API_KEY_3=

# ---- uyanık tutma (yalnız NODE_ENV=production) ----
# Boşsa APP_URL kullanılır. 10 dk'da bir /api/health yoklanır; yalnız uyanık TUTAR, uyandırmaz.
KEEPALIVE_URL=

# Uygulamanın genel kök URL'i — e-posta bağlantıları bununla üretilir.
APP_URL=
