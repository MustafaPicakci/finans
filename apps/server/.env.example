# PostgreSQL bağlantısı (Faz 5.0 — zorunlu). Yerel Docker Postgres örneği:
DATABASE_URL=postgresql://postgres:1@localhost:5432/finans

# TEFAS fon fiyatları için RapidAPI anahtarı (opsiyonel).
# https://rapidapi.com/serifcolakel/api/tefas-api — resmi değil, üçüncü taraf aracı.
# Boş bırakılırsa fonlar elle fiyatlanır (Portföy sekmesinde rozet+sıfırla).
RAPIDAPI_KEY=
# İkinci anahtar (opsiyonel) — birinci kota/hız sınırına (429) takılırsa otomatik buna geçilir.
# Aynı hesaptan ikinci bir uygulama/anahtar oluşturarak günlük kotayı ikiye katlayabilirsin.
RAPIDAPI_KEY_2=

# E-posta gönderimi (Faz 6 — şifre sıfırlama & hesap aktivasyonu). Generic SMTP; boş bırakılırsa
# e-posta gönderilmez, içerik/bağlantı sunucu loguna yazılır (dev).
#
# PROD (önerilen) — transactional sağlayıcı + kendi domain'in. Gmail SMTP prod'da YETMEZ:
# gönderim "250 OK" dönse bile alıcı sunucular "hesabını aktive et + buton + link" içeren,
# gmail.com'dan gelen ama başka bir siteyi işaret eden postayı phishing sayıp sessizce düşürebilir
# (gerçekte yaşandı: kurumsal alan adına ulaşmadı). Çözüm, domain'ini doğrulayıp oradan göndermek.
#   Resend örneği:  SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<API anahtarı>
#                   MAIL_FROM="Finans <no-reply@<domain>>"
#   Brevo örneği:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<hesap>  SMTP_PASS=<SMTP anahtarı>
# Sağlayıcıda domain'i eklerken verilen SPF/DKIM (ve tercihen DMARC) DNS kayıtlarını yayınla;
# MAIL_FROM alan adı doğrulanan domain ile AYNI olmalı, yoksa teslim yine zayıf kalır.
#
# DEV/test — Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<gmail adresin>
#   SMTP_PASS=<Google "uygulama parolası" — normal şifre DEĞİL; 2FA açıkken hesap ayarlarından üretilir>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gönderen görünen adı/adresi (opsiyonel; boşsa "Finans <SMTP_USER>"). Prod'da doğrulanmış
# domain'inden ver: MAIL_FROM=Finans <no-reply@ornek.com>
MAIL_FROM=
# ---- AI asistan (Faz 22) ----
# Boş bırakılırsa Asistan sekmesi "kapalı" görünür; uygulamanın geri kalanı etkilenmez.
# Model sağlayıcısı soyutlanmıştır (apps/server/ai/provider.ts): iki protokol desteklenir,
# değiştirmek için yalnız bu env'ler yeter.
#
#   gemini (varsayılan) — Google AI Studio anahtarı, ücretsiz kotalı, Türkçesi iyi:
#     AI_PROVIDER=gemini   AI_MODEL=gemini-3.6-flash   AI_API_KEY=<AI Studio anahtarı>
#   Google eski sürümleri yeni anahtarlara kapatabiliyor ("no longer available to new users").
#   Anahtarına açık modelleri listele, AI_MODEL'i ona göre sabitle:
#     curl -H "x-goog-api-key: $AI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
#
#   openai — /chat/completions uyumlu HER servis (Groq, OpenRouter, Together, yerel Ollama…):
#     Groq (ücretsiz kotalı, çok hızlı):
#       AI_PROVIDER=openai  AI_BASE_URL=https://api.groq.com/openai/v1
#       AI_MODEL=llama-3.3-70b-versatile  AI_API_KEY=<groq anahtarı>
#     OpenRouter (ücretsiz modeller ":free" ekiyle):
#       AI_PROVIDER=openai  AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<model>:free
#
# Seçtiğin model FUNCTION CALLING (araç çağırma) desteklemek ZORUNDA — asistanın tek işi
# araç çağırmak; desteklemeyen model sohbet eder ama hiçbir kayıt oluşturamaz.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Uygulamanın herkese açık kök URL'i — e-posta bağlantıları bununla üretilir (ör. https://finans-xxx.onrender.com).
# Boşsa isteğin Origin/host başlığından türetilir (yerelde genelde yeterli).
APP_URL=
