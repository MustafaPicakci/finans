{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    /* DOM: WebCrypto tipleri (CryptoKey, crypto.subtle, TextEncoder) buradan gelir.
       Bu paket bilinçli olarak YALNIZ tarayıcıda çalışır — apps/server onu import
       ETMEMELİ, çünkü "sunucu anahtarı göremez" garantisinin yapısal olması gerekiyor. */
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src"]
}
